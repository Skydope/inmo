# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# docs de trabajo (referencias y spec inicial)
/docs/references/
/docs/spec-alcance-v1.md

# tooling de agentes (skill local, binario compilado y screenshots del tool)
/.agents/
/.cursor/
/.impeccable/

# capturas y logs del MCP de Playwright
/.playwright-mcp/

# resultados de Playwright
/playwright-report/
/test-results/

# el binario de la skill impeccable pesa 18 MB y se baja solo al primer uso
.claude/skills/impeccable/scripts/bin/
